# Copy to .env and set the two passwords. .env is never committed.
# Every setting below except the passwords and fees has a default in src/settings.py.

# --- Database (local PostgreSQL) ----------------------------------------------------------------
# scripts/setup_database.sh creates both roles with these passwords.
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=rl_strategy_lab
# Writer role: ingest, training, migrations, request logging.
DATABASE_WRITER_USER=rl_writer
DATABASE_WRITER_PASSWORD=change-me
# Read-only role: assistant tools, API, analysis notebook.
DATABASE_READER_USER=rl_reader
DATABASE_READER_PASSWORD=change-me

# --- Market data ---------------------------------------------------------------------------------
TICKERS=NVDA,AMD,INTC
HISTORY_START=2021-01-01
# Empty HISTORY_END means "up to today".
HISTORY_END=

# --- Evaluation windows --------------------------------------------------------------------------
# Trading days after TEST_END are the forward period (`make refresh`).
TRAIN_START=2021-01-01
TRAIN_END=2024-12-31
TEST_START=2025-01-01
TEST_END=2025-12-31

# --- Trading rules -------------------------------------------------------------------------------
# Fees as a fraction of the trade value (0.001 = 0.1%). Applied to agents and buy-and-hold alike.
BUY_FEE_RATE=0.001
SELL_FEE_RATE=0.001
# How many past days of features the agent sees each step.
OBSERVATION_WINDOW_DAYS=2

# --- Training grid -------------------------------------------------------------------------------
ALGORITHMS=A2C,DQN,PPO
FEATURE_SETS=standard,indicators
SEEDS=0,1,2,3,4
TRAIN_TIMESTEPS=20000
# One CPU thread per agent: faster than more for these small networks, and reproducible.
TORCH_THREADS=1
MODELS_DIR=data/models

# --- Analysis (Sharpe ratio and the buy-and-hold confidence interval) ---------------------------
# Annual risk-free rate as a fraction, used in the Sharpe ratio.
RISK_FREE_RATE=0
CONFIDENCE_LEVEL=0.95
BOOTSTRAP_SAMPLES=10000
BOOTSTRAP_BLOCK_DAYS=10
BOOTSTRAP_RANDOM_SEED=0

# --- Assistant (Qwen via Ollama) -----------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
ASSISTANT_MODEL=qwen3:8b
ASSISTANT_TEMPERATURE=0
# Maximum tool-calling rounds before the assistant must answer.
ASSISTANT_MAX_TOOL_ROUNDS=4
ASSISTANT_REQUEST_TIMEOUT_SECONDS=180
# A stated number matches a tool value if it is within this relative difference
# (on top of the rounding implied by how many decimals the answer shows).
GROUNDING_RELATIVE_TOLERANCE=0.001
# The equity-curve tool returns at most this many points, to keep the model's context small.
EQUITY_CURVE_MAX_POINTS=30

# --- API and outputs -----------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
DASHBOARD_DATA_DIR=web/public/data
EVALUATION_REPORTS_DIR=evals/results
